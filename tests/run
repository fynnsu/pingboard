#!/usr/bin/env bash
# Runs every check in this folder against the working tree. CI runs this same script.
# Set PINGBOARD_BASE to a checkout of the previous version to also check upgrading from it.
set -euo pipefail
cd "$(dirname "$0")"

if command -v bun >/dev/null 2>&1; then
  bun install --frozen-lockfile
  runner=bun
else
  npm install --no-package-lock
  runner=node
fi

# An installed Chrome/Edge can run the suite without a browser download.
if [ -z "${PINGBOARD_BROWSER_CHANNEL:-}" ]; then
  "$runner" node_modules/playwright/cli.js install ${CI:+--with-deps} chromium
fi

for check in *.mjs; do
  "$runner" "$check" --head .. ${PINGBOARD_BASE:+--base "$PINGBOARD_BASE"}
done
